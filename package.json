{
  "name": "oda",
  "productName": "ODA",
  "version": "0.1.0",
  "description": "ODA — arkadaşlar için ODA sunucusu üzerinden sesli sohbet ve mesajlaşma",
  "author": "Tasarimola <hello@tasarimola.com> (https://tasarimola.com)",
  "homepage": "https://tasarimola.com",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "icon": "node scripts/make-icon.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build:main && vite build && electron .",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-sfu.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "livekit-client": "2.22.3",
    "lucide-react": "^1.48.0",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "selfsigned": "^5.5.0",
    "typescript": "5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.oda.app",
    "productName": "ODA",
    "copyright": "Tasarimola.com",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "!dist/server/**",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/after-pack.cjs",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "ODA",
      "artifactName": "ODA-Setup-x64.exe",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ODA",
      "uninstallDisplayName": "ODA",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "tr_TR"
      ],
      "language": "1055",
      "multiLanguageInstaller": true,
      "differentialPackage": false,
      "include": "build/installer.nsh"
    }
  }
}
