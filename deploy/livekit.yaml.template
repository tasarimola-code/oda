# ODA media server (LiveKit). The API/signaling port stays on loopback: only the ODA server
# talks to it and proxies client signaling after checking who is in which voice room.
# Media ports (7881/tcp, 7882/udp) must be reachable from the internet.
port: 7880
bind_addresses:
  - 127.0.0.1
rtc:
  tcp_port: 7881
  udp_port: 7882
  use_external_ip: false
  node_ip: __NODE_IP__
__IPS__
keys:
  __KEY__: __SECRET__
room:
  max_participants: 50
  empty_timeout: 300
logging:
  level: info
